// KLAESP server schema. Stores identifiers and session hashes only:
// no passwords and no LMS or Google tokens. See docs/decisions/0002-onboarding-workflow.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LmsProvider {
  MOODLE
  // Google account identity (sign-in). Classroom access is a separate grant, not implied by this row.
  GOOGLE
}

model User {
  id        String   @id @default(uuid()) @db.Uuid
  email     String   @unique
  fullName  String   @map("full_name")
  studentId String?  @map("student_id")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  lmsConnections LmsConnection[]
  sessions       Session[]

  @@map("users")
}

model LmsConnection {
  id             String      @id @default(uuid()) @db.Uuid
  userId         String      @map("user_id") @db.Uuid
  provider       LmsProvider
  // Moodle: the site URL. Google: "https://accounts.google.com".
  siteUrl        String      @map("site_url")
  // Moodle user ID, or Google account `sub`. This is the sign-in identity for Moodle.
  externalUserId String      @map("external_user_id")
  // Google email only.
  externalEmail  String?     @map("external_email")
  connectedAt    DateTime    @default(now()) @map("connected_at")
  lastSyncedAt   DateTime?   @map("last_synced_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One external account links to one app user, and one user has at most one connection per provider.
  @@unique([provider, siteUrl, externalUserId])
  @@unique([userId, provider])
  @@index([userId])
  @@map("lms_connections")
}

// Server session for the app. Only a hash of the session token is stored.
model Session {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  createdAt DateTime  @default(now()) @map("created_at")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}
